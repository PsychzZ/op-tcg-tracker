DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"
AUTH_SECRET="generate-with-node-crypto-or-npx-auth-secret"
OWNER_EMAIL="you@example.com"
OWNER_PASSWORD="set-a-strong-password"
CRON_SECRET="generate-with-node-crypto-randomBytes-hex"

# Raw prices + catalog (PriceCharting Collector subscription). 40-char token from
# pricecharting.com → Account/Subscriptions → "API/Download".
PRICECHARTING_TOKEN="your-40-char-pricecharting-token"

# PSA 9/10 prices via eBay sold listings (Apify). Personal API token from
# Apify Console → Settings → Integrations. Actor defaults to automation-lab~ebay-sold-scraper.
APIFY_TOKEN="your-apify-api-token"
APIFY_EBAY_ACTOR="automation-lab~ebay-sold-scraper"

# Optional: Discord/Slack-style incoming webhook that gets a short "Zielpreis erreicht" message
# whenever a watchlist target price is hit during the price sync. Leave empty to keep alerts
# in-app only.
ALERT_WEBHOOK_URL=""

# --- Self-hosting (Raspberry Pi): local Postgres via docker-compose.yml ---
# Swap DATABASE_URL above for this when running against the local DB:
# DATABASE_URL="postgresql://opvault:opvault@localhost:5432/opvault?schema=public"
# POSTGRES_USER=opvault
# POSTGRES_PASSWORD=opvault
# POSTGRES_DB=opvault
